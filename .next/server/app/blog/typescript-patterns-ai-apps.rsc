,null,{"className":"mt-2 text-sm","style":{"color":"var(--text-muted)","maxWidth":420},"children":"I scanned every endpoint twice. Whatever you were looking for either moved, or never shipped."}],["$","div",null,{"className":"mt-8 flex gap-4 flex-wrap justify-center","children":[["$","$L2",null,{"href":"/","className":"font-mono text-xs uppercase tracking-wider","style":{"padding":"13px 26px","background":"var(--accent)","color":"var(--bg)","textDecoration":"none","fontWeight":700},"children":"Take me home"}],["$","$L2",null,{"href":"/terminal","className":"font-mono text-xs uppercase tracking-wider","style":{"padding":"13px 26px","border":"1px solid var(--border-bright)","color":"var(--text-muted)","textDecoration":"none"},"children":"Open terminal"}]]}]]}],"notFoundStyles":[],"styles":null}]}]}]}],["$","$L15",null,{}],["$","$L16",null,{}],["$","$L17",null,{}],["$","$L18",null,{}],["$","$L19",null,{}],["$","$L1a",null,{}],["$","$L1b",null,{}],["$","$L1c",null,{}],["$","$L1d",null,{}],["$","$L1e",null,{}],["$","$L1f",null,{}],["$","$L20",null,{}],["$","$L21",null,{}]]}]}]]}]}],null],null],[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/9d18d9718c4fde81.css","precedence":"next","crossOrigin":"$undefined"}]],[null,"$L22"]]]]]
3:[["$","h1",null,{"children":"TypeScript Patterns I Use in Every AI Application","style":{"fontFamily":"'Syne',sans-serif","fontSize":"2rem","fontWeight":800,"color":"var(--text)","marginBottom":"1.5rem","lineHeight":1.2}}],"\n",["$","p",null,{"children":"Building AI applications in TypeScript adds a layer of safety that is genuinely useful — LLM APIs return untyped JSON, and without a good type strategy, bugs hide until production. Here are the patterns I reach for every time.","style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","h2",null,{"children":"1. Typed LLM Response Schemas with Zod","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","p",null,{"children":"Never trust raw LLM output. Define a schema and validate before using:","style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","pre",null,{"children":["$","pre",null,{"style":{"background":"#080808","border":"1px solid var(--border)","padding":"1.25rem 1.5rem","overflowX":"auto","marginBottom":"1.5rem"},"children":["$","code",null,{"className":"language-typescript","children":"import { z } from 'zod';\n\nconst AnalysisSchema = z.object({\n  summary: z.string(),\n  sentiment: z.enum(['positive', 'negative', 'neutral']),\n  confidence: z.number().min(0).max(1),\n  keywords: z.array(z.string()),\n});\n\ntype Analysis = z.infer<typeof AnalysisSchema>;\n\nasync function analyzeText(text: string): Promise<Analysis> {\n  const raw = await openai.chat.completions.create({\n    model: 'gpt-4o',\n    messages: [{ role: 'user', content: `Analyze: ${text}` }],\n    response_format: { type: 'json_object' },\n  });\n\n  const parsed = JSON.parse(raw.choices[0].message.content ?? '{}');\n  return AnalysisSchema.parse(parsed); // throws if schema mismatch\n}\n","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","lineHeight":1.7,"color":"#e8a838"}}]}]}],"\n",["$","h2",null,{"children":"2. Discriminated Unions for AI Pipeline Results","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","p",null,{"children":"AI pipelines have multiple failure modes. Model them explicitly:","style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","pre",null,{"children":["$","pre",null,{"style":{"background":"#080808","border":"1px solid var(--border)","padding":"1.25rem 1.5rem","overflowX":"auto","marginBottom":"1.5rem"},"children":["$","code",null,{"className":"language-typescript","children":"type PipelineResult<T> =\n  | { status: 'success'; data: T; latencyMs: number }\n  | { status: 'rate_limited'; retryAfterMs: number }\n  | { status: 'context_overflow'; tokenCount: number }\n  | { status: 'error'; message: string };\n\nasync function runPipeline(input: string): Promise<PipelineResult<Analysis>> {\n  try {\n    const start = Date.now();\n    const data = await analyzeText(input);\n    return { status: 'success', data, latencyMs: Date.now() - start };\n  } catch (err) {\n    if (err instanceof RateLimitError) {\n      return { status: 'rate_limited', retryAfterMs: err.retryAfter * 1000 };\n    }\n    return { status: 'error', message: String(err) };\n  }\n}\n\n// Usage — TypeScript forces you to handle every case\nconst result = await runPipeline(userInput);\nif (result.status === 'success') {\n  console.log(result.data.summary);   // ✅ typed\n} else if (result.status === 'rate_limited') {\n  await sleep(result.retryAfterMs);   // ✅ typed\n}\n","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","lineHeight":1.7,"color":"#e8a838"}}]}]}],"\n",["$","h2",null,{"children":"3. Streaming with AsyncIterator Types","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","p",null,{"children":"OpenAI streaming returns chunks. Type them properly:","style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","pre",null,{"children":["$","pre",null,{"style":{"background":"#080808","border":"1px solid var(--border)","padding":"1.25rem 1.5rem","overflowX":"auto","marginBottom":"1.5rem"},"children":["$","code",null,{"className":"language-typescript","children":"async function* streamCompletion(\n  prompt: string\n): AsyncGenerator<string, void, unknown> {\n  const stream = await openai.chat.completions.create({\n    model: 'gpt-4o',\n    messages: [{ role: 'user', content: prompt }],\n    stream: true,\n  });\n\n  for await (const chunk of stream) {\n    const delta = chunk.choices[0]?.delta?.content;\n    if (delta) yield delta;\n  }\n}\n\n// Consume it\nfor await (const token of streamCompletion('Explain RAG')) {\n  process.stdout.write(token);\n}\n","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","lineHeight":1.7,"color":"#e8a838"}}]}]}],"\n",["$","h2",null,{"children":"4. Generic RAG Context Type","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","p",null,{"children":"When building RAG pipelines, a generic context type keeps retrieval and generation loosely coupled:","style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","pre",null,{"children":["$","pre",null,{"style":{"background":"#080808","border":"1px solid var(--border)","padding":"1.25rem 1.5rem","overflowX":"auto","marginBottom":"1.5rem"},"children":["$","code",null,{"className":"language-typescript","children":"interface RAGContext<TMetadata = Record<string, unknown>> {\n  content: string;\n  score: number;\n  metadata: TMetadata;\n  source: string;\n}\n\ninterface DocumentMetadata {\n  pageNumber: number;\n  filename: string;\n  lastModified: Date;\n}\n\ntype DocumentContext = RAGContext<DocumentMetadata>;\n\nasync function retrieve(query: string): Promise<DocumentContext[]> {\n  // vector DB call returns typed results\n}\n","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","lineHeight":1.7,"color":"#e8a838"}}]}]}],"\n",["$","h2",null,{"children":"5. Const Assertion for Model Names","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","p",null,{"children":"Avoid magic strings — define allowed models once:","style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","pre",null,{"children":["$","pre",null,{"style":{"background":"#080808","border":"1px solid var(--border)","padding":"1.25rem 1.5rem","overflowX":"auto","marginBottom":"1.5rem"},"children":["$","code",null,{"className":"language-typescript","children":"const MODELS = {\n  fast: 'gpt-4o-mini',\n  capable: 'gpt-4o',\n  embedding: 'text-embedding-3-small',\n} as const;\n\ntype ModelKey = keyof typeof MODELS;\ntype ModelId = (typeof MODELS)[ModelKey];\n\nfunction createClient(model: ModelKey) {\n  return new OpenAIClient({ model: MODELS[model] });\n}\n","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","lineHeight":1.7,"color":"#e8a838"}}]}]}],"\n",["$","h2",null,{"children":"Wrapping Up","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","p",null,{"children":"These five patterns — Zod validation, discriminated unions, typed streaming, generic RAG contexts, and const assertions — have caught dozens of bugs before they reached production in my AI projects. TypeScript's type system is especially valuable with LLMs because the API surface is inherently dynamic.","style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","hr",null,{"style":{"border":"none","borderTop":"1px solid var(--border)","margin":"2.5rem 0"}}],"\n",["$","p",null,{"children":["$","em",null,{"children":["Building AI applications? Let's connect on ",["$","a",null,{"href":"https://www.linkedin.com/in/vaibhavbansal-profile/","children":"LinkedIn","style":{"color":"#e8a838","textDecoration":"none","borderBottom":"1px solid rgba(232,168,56,.4)"}}]," or check my ",["$","a",null,{"href":"https://github.com/VaibhavBansal26","children":"GitHub","style":{"color":"#e8a838","textDecoration":"none","borderBottom":"1px solid rgba(232,168,56,.4)"}}]," for open-source AI projects."]}],"style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}]]
