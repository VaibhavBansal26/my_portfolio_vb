["Add a ",["$","code",null,{"children":".github/workflows/ci.yml","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}]," to run lint and type checks on every PR before code merges to ",["$","code",null,{"children":"main","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}],":"],"style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","pre",null,{"children":["$","pre",null,{"style":{"background":"#080808","border":"1px solid var(--border)","padding":"1.25rem 1.5rem","overflowX":"auto","marginBottom":"1.5rem"},"children":["$","code",null,{"className":"language-yaml","children":"name: CI\non:\n  pull_request:\n    branches: [main]\njobs:\n  ci:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with: { node-version: '20', cache: 'npm' }\n      - run: npm ci\n      - run: npm run lint\n      - run: npx tsc --noEmit\n      - run: npm run build\n","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","lineHeight":1.7,"color":"#e8a838"}}]}]}],"\n",["$","h2",null,{"children":"Step 6: Connect Your Domain","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","h3",null,{"children":"Option A — Point nameservers to Hostinger","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.1rem","fontWeight":700,"color":"var(--text)","marginTop":"2rem","marginBottom":"0.75rem"}}],"\n",["$","p",null,{"children":"In GoDaddy (or your registrar), set nameservers to Hostinger's (found in hPanel → Domains). This lets Hostinger manage DNS and handle SSL automatically.","style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","h3",null,{"children":"Option B — Keep DNS at GoDaddy","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.1rem","fontWeight":700,"color":"var(--text)","marginTop":"2rem","marginBottom":"0.75rem"}}],"\n",["$","p",null,{"children":["Get your server IP from hPanel and add an ",["$","code",null,{"children":"A","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}]," record in GoDaddy pointing ",["$","code",null,{"children":"@","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}]," to it. Then install Let's Encrypt SSL in hPanel → SSL."],"style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","h2",null,{"children":"Step 7: Verify Everything","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","pre",null,{"children":["$","pre",null,{"style":{"background":"#080808","border":"1px solid var(--border)","padding":"1.25rem 1.5rem","overflowX":"auto","marginBottom":"1.5rem"},"children":["$","code",null,{"className":"language-bash","children":"# Test your live endpoints\ncurl https://yourdomain.com/sitemap.xml\ncurl https://yourdomain.com/robots.txt\ncurl https://yourdomain.com/api/github-stats\n","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","lineHeight":1.7,"color":"#e8a838"}}]}]}],"\n",["$","p",null,{"children":"Run a Lighthouse audit with:","style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","pre",null,{"children":["$","pre",null,{"style":{"background":"#080808","border":"1px solid var(--border)","padding":"1.25rem 1.5rem","overflowX":"auto","marginBottom":"1.5rem"},"children":["$","code",null,{"className":"language-bash","children":"npx lighthouse https://yourdomain.com --view\n","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","lineHeight":1.7,"color":"#e8a838"}}]}]}],"\n",["$","p",null,{"children":"Aim for Performance ≥ 85, SEO ≥ 90, Accessibility ≥ 90.","style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","h2",null,{"children":"Conclusion","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","p",null,{"children":"Hostinger's managed Node.js hosting is a solid Vercel alternative for production Next.js apps. You get SSR, API routes, automatic deployments from GitHub, and global CDN — all at a predictable price.","style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","hr",null,{"style":{"border":"none","borderTop":"1px solid var(--border)","margin":"2.5rem 0"}}],"\n",["$","p",null,{"children":["$","em",null,{"children":["Have questions about the setup? Drop a comment or connect with me on ",["$","a",null,{"href":"https://www.linkedin.com/in/vaibhavbansal-profile/","children":"LinkedIn","style":{"color":"#e8a838","textDecoration":"none","borderBottom":"1px solid rgba(232,168,56,.4)"}}],"."]}],"style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}]]
