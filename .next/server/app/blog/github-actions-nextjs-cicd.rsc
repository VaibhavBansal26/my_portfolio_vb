3:[["$","h1",null,{"children":"GitHub Actions CI/CD for Next.js: Lint, Test, and Deploy Automatically","style":{"fontFamily":"'Syne',sans-serif","fontSize":"2rem","fontWeight":800,"color":"var(--text)","marginBottom":"1.5rem","lineHeight":1.2}}],"\n",["$","p",null,{"children":"A good CI/CD pipeline catches bugs before users do. For my portfolio and client projects, I use three GitHub Actions workflows that together give me confidence that nothing broken ever reaches production.","style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","h2",null,{"children":"The Three-Workflow Strategy","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","p",null,{"children":["| Workflow | Trigger | Purpose |\n|----------|---------|---------|\n| ",["$","code",null,{"children":"ci.yml","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}]," | Every PR | Lint + TypeScript + build check |\n| ",["$","code",null,{"children":"lighthouse.yml","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}]," | PRs to ",["$","code",null,{"children":"main","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}]," | Performance & SEO audit |\n| ",["$","code",null,{"children":"deploy.yml","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}]," | Push to ",["$","code",null,{"children":"main","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}]," | Build + deploy to server |"],"style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","h2",null,{"children":"Workflow 1: CI Checks on Every PR","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","pre",null,{"children":["$","pre",null,{"style":{"background":"#080808","border":"1px solid var(--border)","padding":"1.25rem 1.5rem","overflowX":"auto","marginBottom":"1.5rem"},"children":["$","code",null,{"className":"language-yaml","children":"# .github/workflows/ci.yml\nname: CI\n\non:\n  pull_request:\n    branches: [main]\n\njobs:\n  ci:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n\n      - uses: actions/setup-node@v4\n        with:\n          node-version: '20'\n          cache: 'npm'\n\n      - run: npm ci\n      - run: npm run lint\n      - run: npx tsc --noEmit\n      - run: npm run build\n        env:\n          NEXT_PUBLIC_SITE_URL: https://example.com\n","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","lineHeight":1.7,"color":"#e8a838"}}]}]}],"\n",["$","p",null,{"children":"This runs in about 2–3 minutes and blocks merges if anything fails.","style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","h2",null,{"children":"Workflow 2: Lighthouse CI on PRs","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","p",null,{"children":"Lighthouse scores your app on performance, SEO, and accessibility on every PR. A regression in bundle size or missing meta tags gets caught before merge:","style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","pre",null,{"children":["$","pre",null,{"style":{"background":"#080808","border":"1px solid var(--border)","padding":"1.25rem 1.5rem","overflowX":"auto","marginBottom":"1.5rem"},"children":["$","code",null,{"className":"language-yaml","children":"# .github/workflows/lighthouse.yml\nname: Lighthouse CI\n\non:\n  pull_request:\n    branches: [main]\n\njobs:\n  lighthouse:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with: { node-version: '20', cache: 'npm' }\n\n      - run: npm ci\n      - run: npm run build\n      - run: npm start &\n        env: { PORT: 3000 }\n      - run: npx wait-on http://localhost:3000 --timeout 30000\n\n      - uses: treosh/lighthouse-ci-action@v11\n        with:\n          urls: http://localhost:3000\n          budgetPath: .github/lighthouse-budget.json\n          uploadArtifacts: true\n          temporaryPublicStorage: true\n","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","lineHeight":1.7,"color":"#e8a838"}}]}]}],"\n",["$","p",null,{"children":["Set your score thresholds in ",["$","code",null,{"children":".github/lighthouse-budget.json","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}],":"],"style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","pre",null,{"children":["$","pre",null,{"style":{"background":"#080808","border":"1px solid var(--border)","padding":"1.25rem 1.5rem","overflowX":"auto","marginBottom":"1.5rem"},"children":["$","code",null,{"className":"language-json","children":"[{\n  \"path\": \"/*\",\n  \"assertions\": {\n    \"categories:performance\":   [\"warn\",  { \"minScore\": 0.85 }],\n    \"categories:seo\":           [\"error\", { \"minScore\": 0.90 }],\n    \"categories:accessibility\": [\"error\", { \"minScore\": 0.90 }]\n  }\n}]\n","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","lineHeight":1.7,"color":"#e8a838"}}]}]}],"\n",["$","h2",null,{"children":"Workflow 3: Deploy on Merge to Main","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","p",null,{"children":["This workflow only runs after CI passes (via ",["$","code",null,{"children":"needs","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}],"):"],"style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","pre",null,{"children":["$","pre",null,{"style":{"background":"#080808","border":"1px solid var(--border)","padding":"1.25rem 1.5rem","overflowX":"auto","marginBottom":"1.5rem"},"children":["$","code",null,{"className":"language-yaml","children":"# .github/workflows/deploy.yml\nname: Deploy\n\non:\n  push:\n    branches: [main]\n\nconcurrency:\n  group: deploy-production\n  cancel-in-progress: false\n\njobs:\n  build-and-deploy:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with: { node-version: '20', cache: 'npm' }\n\n      - run: npm ci\n      - run: npm run lint\n      - run: npx tsc --noEmit\n      - run: npm run build\n        env:\n          NEXT_PUBLIC_SITE_URL: ${{ secrets.NEXT_PUBLIC_SITE_URL }}\n          GITHUB_TOKEN: ${{ secrets.GH_PAT_TOKEN }}\n\n      - name: Deploy via SSH\n        uses: appleboy/ssh-action@v1.0.3\n        with:\n          host: ${{ secrets.SSH_HOST }}\n          username: ${{ secrets.SSH_USERNAME }}\n          key: ${{ secrets.SSH_PRIVATE_KEY }}\n          script: |\n            cd ${{ secrets.APP_DIR }}\n            git pull origin main\n            npm ci\n            npm run build\n            echo \"Done\"\n","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","lineHeight":1.7,"color":"#e8a838"}}]}]}],"\n",["$","h2",null,{"children":"Required GitHub Secrets","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","p",null,{"children":["Add these in ",["$","strong",null,{"children":"Settings → Secrets → Actions","style":{"color":"var(--text)","fontWeight":700}}],":"],"style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","p",null,{"children":["| Secret | Value |\n|--------|-------|\n| ",["$","code",null,{"children":"SSH_HOST","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}]," | Your server IP |\n| ",["$","code",null,{"children":"SSH_USERNAME","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}]," | SSH user |\n| ",["$","code",null,{"children":"SSH_PRIVATE_KEY","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}]," | Private key (generate with ",["$","code",null,{"children":"ssh-keygen -t ed25519","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}],") |\n| ",["$","code",null,{"children":"APP_DIR","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}]," | Path to your app on the server |\n| ",["$","code",null,{"children":"NEXT_PUBLIC_SITE_URL","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}]," | Your live domain |\n| ",["$","code",null,{"children":"GH_PAT_TOKEN","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}]," | GitHub PAT for the stats API |"],"style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","h2",null,{"children":"Branch Protection Rules","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","p",null,{"children":["In ",["$","strong",null,{"children":"Settings → Branches → Branch protection rules","style":{"color":"var(--text)","fontWeight":700}}]," for ",["$","code",null,{"children":"main","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}],":"],"style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":["✅ Require status checks to pass before merging (add ",["$","code",null,{"children":"CI Checks","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","background":"rgba(232,168,56,.08)","color":"#e8a838","padding":"2px 6px","border":"1px solid rgba(232,168,56,.2)"}}],")"],"style":{"marginBottom":"0.4rem","fontFamily":"'Inter',sans-serif","fontSize":"15px"}}],"\n",["$","li",null,{"children":"✅ Require branches to be up to date before merging","style":{"marginBottom":"0.4rem","fontFamily":"'Inter',sans-serif","fontSize":"15px"}}],"\n",["$","li",null,{"children":"✅ Require conversation resolution before merging","style":{"marginBottom":"0.4rem","fontFamily":"'Inter',sans-serif","fontSize":"15px"}}],"\n"],"style":{"paddingLeft":"1.5rem","marginBottom":"1.25rem","color":"var(--text-muted)","lineHeight":1.8}}],"\n",["$","p",null,{"children":"This ensures no one (including you) can push broken code to production.","style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","h2",null,{"children":"Result","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","p",null,{"children":"With this setup:","style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Every PR gets lint + type + build checks automatically","style":{"marginBottom":"0.4rem","fontFamily":"'Inter',sans-serif","fontSize":"15px"}}],"\n",["$","li",null,{"children":"Lighthouse audits catch SEO and performance regressions before they ship","style":{"marginBottom":"0.4rem","fontFamily":"'Inter',sans-serif","fontSize":"15px"}}],"\n",[