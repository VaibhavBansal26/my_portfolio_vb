3:[["$","h1",null,{"children":"MLOps: Taking ML Models from Notebook to Production","style":{"fontFamily":"'Syne',sans-serif","fontSize":"2rem","fontWeight":800,"color":"var(--text)","marginBottom":"1.5rem","lineHeight":1.2}}],"\n",["$","p",null,{"children":["Most ML engineers are great at training models. Far fewer know how to ",["$","strong",null,{"children":"deploy and maintain","style":{"color":"var(--text)","fontWeight":700}}]," them reliably. MLOps bridges this gap."],"style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","h2",null,{"children":"Why MLOps Matters","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","p",null,{"children":"A model rotting in a Jupyter notebook helps nobody. The real challenge is:","style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Reproducibility","style":{"color":"var(--text)","fontWeight":700}}]," — can you recreate the exact model that's in production?"],"style":{"marginBottom":"0.4rem","fontFamily":"'Inter',sans-serif","fontSize":"15px"}}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Monitoring","style":{"color":"var(--text)","fontWeight":700}}]," — how do you know when model performance degrades?"],"style":{"marginBottom":"0.4rem","fontFamily":"'Inter',sans-serif","fontSize":"15px"}}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Iteration","style":{"color":"var(--text)","fontWeight":700}}]," — how quickly can you ship improvements?"],"style":{"marginBottom":"0.4rem","fontFamily":"'Inter',sans-serif","fontSize":"15px"}}],"\n"],"style":{"paddingLeft":"1.5rem","marginBottom":"1.25rem","color":"var(--text-muted)","lineHeight":1.8}}],"\n",["$","h2",null,{"children":"Experiment Tracking with MLflow","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","pre",null,{"children":["$","pre",null,{"style":{"background":"#080808","border":"1px solid var(--border)","padding":"1.25rem 1.5rem","overflowX":"auto","marginBottom":"1.5rem"},"children":["$","code",null,{"className":"language-python","children":"import mlflow\nimport mlflow.sklearn\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import accuracy_score, f1_score\n\nmlflow.set_experiment(\"heart-disease-prediction\")\n\nwith mlflow.start_run():\n    # Log parameters\n    params = {\"n_estimators\": 100, \"max_depth\": 8}\n    mlflow.log_params(params)\n    \n    # Train\n    model = RandomForestClassifier(**params)\n    model.fit(X_train, y_train)\n    \n    # Log metrics\n    preds = model.predict(X_test)\n    mlflow.log_metric(\"accuracy\", accuracy_score(y_test, preds))\n    mlflow.log_metric(\"f1_score\", f1_score(y_test, preds))\n    \n    # Log model\n    mlflow.sklearn.log_model(model, \"model\")\n","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","lineHeight":1.7,"color":"#e8a838"}}]}]}],"\n",["$","h2",null,{"children":"Dockerizing Your ML Service","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","pre",null,{"children":["$","pre",null,{"style":{"background":"#080808","border":"1px solid var(--border)","padding":"1.25rem 1.5rem","overflowX":"auto","marginBottom":"1.5rem"},"children":["$","code",null,{"className":"language-dockerfile","children":"FROM python:3.11-slim\n\nWORKDIR /app\nCOPY requirements.txt .\nRUN pip install --no-cache-dir -r requirements.txt\n\nCOPY . .\nEXPOSE 8000\n\nCMD [\"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8000\"]\n","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","lineHeight":1.7,"color":"#e8a838"}}]}]}],"\n",["$","h2",null,{"children":"FastAPI Serving","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","pre",null,{"children":["$","pre",null,{"style":{"background":"#080808","border":"1px solid var(--border)","padding":"1.25rem 1.5rem","overflowX":"auto","marginBottom":"1.5rem"},"children":["$","code",null,{"className":"language-python","children":"from fastapi import FastAPI\nimport mlflow.pyfunc\nimport pandas as pd\n\napp = FastAPI()\nmodel = mlflow.pyfunc.load_model(\"models:/heart-disease-classifier/production\")\n\n@app.post(\"/predict\")\nasync def predict(features: dict):\n    df = pd.DataFrame([features])\n    prediction = model.predict(df)\n    return {\"prediction\": int(prediction[0]), \"probability\": float(prediction[1])}\n","style":{"fontFamily":"'JetBrains Mono',monospace","fontSize":"12px","lineHeight":1.7,"color":"#e8a838"}}]}]}],"\n",["$","h2",null,{"children":"Key Takeaways","style":{"fontFamily":"'Syne',sans-serif","fontSize":"1.4rem","fontWeight":700,"color":"var(--text)","marginTop":"2.5rem","marginBottom":"1rem","borderBottom":"1px solid var(--border)","paddingBottom":"0.5rem"}}],"\n",["$","ol",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Track everything","style":{"color":"var(--text)","fontWeight":700}}]," — use MLflow from day one"],"style":{"marginBottom":"0.4rem","fontFamily":"'Inter',sans-serif","fontSize":"15px"}}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Containerize","style":{"color":"var(--text)","fontWeight":700}}]," — Docker makes deployment environment-agnostic"],"style":{"marginBottom":"0.4rem","fontFamily":"'Inter',sans-serif","fontSize":"15px"}}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Monitor","style":{"color":"var(--text)","fontWeight":700}}]," — set up alerts for data drift and performance degradation"],"style":{"marginBottom":"0.4rem","fontFamily":"'Inter',sans-serif","fontSize":"15px"}}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Automate","style":{"color":"var(--text)","fontWeight":700}}]," — CI/CD for ML is just as important as for software"],"style":{"marginBottom":"0.4rem","fontFamily":"'Inter',sans-serif","fontSize":"15px"}}],"\n"],"style":{"paddingLeft":"1.5rem","marginBottom":"1.25rem","color":"var(--text-muted)","lineHeight":1.8}}],"\n",["$","hr",null,{"style":{"border":"none","borderTop":"1px solid var(--border)","margin":"2.5rem 0"}}],"\n",["$","p",null,{"children":["$","em",null,{"children":["Building something similar? Let's connect on ",["$","a",null,{"href":"https://www.linkedin.com/in/vaibhavbansal-profile","children":"LinkedIn","style":{"color":"#e8a838","textDecoration":"none","borderBottom":"1px solid rgba(232,168,56,.4)"}}],"."]}],"style":{"fontFamily":"'Inter',sans-serif","fontSize":"15px","color":"var(--text-muted)","lineHeight":1.8,"marginBottom":"1.25rem"}}]]
